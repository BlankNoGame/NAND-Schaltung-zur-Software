// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Inc16 (in=rgout, out=IncOut);
    Mux16 (a=rgout, b=IncOut, sel=inc, out=muxIncOut);
    Mux16 (a=muxIncOut, b=in, sel=load, out=muxLoadOut);
    Mux16 (a=muxLoadOut, b[0..15]=false, sel=reset, out=muxResOut);

    Register (in=muxResOut, load=true, out=rgout, out=out);
}
