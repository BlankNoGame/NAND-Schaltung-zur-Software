/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {

    static Array ram;
    static int freeList;

    /** Initializes the class. */
    function void init() {
        let ram = 0;
        let freeList = 2048;
        let ram[freeList] = 0;
        let ram[freeList + 1] = 14334;
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let ram[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {
        var int block;
        var int prevBlock;
        var int length;
        var int newBlock;
        var boolean found;

        if (size < 1) {
            do Sys.error(5);
        }
        let block = freeList;
        let prevBlock = 0; 
        let found = false;

        while ((~found) & (~(block = 0))) {
            let length = ram[block + 1];
            if (~(length < size)) {
                let found = true;
            } else {
                let prevBlock = block;
                let block = ram[block];
            }
        }
        if (~found) {
            do Sys.error(6);
        }

        let length = ram[block + 1];

        if (length > (size + 2)) {
            let newBlock = block + 2 + (length - size - 2 ); 
            let ram[newBlock + 1] = size;
            let ram[block + 1] = length - size - 2;
            return newBlock + 2;
        }

        if (prevBlock = 0) {
            let freeList = ram[block];
        } else {
            let ram[prevBlock] = ram[block];
        }
        return block + 2;
    } 

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int block;
        let block = o - 2;
        let ram[block] = freeList;
        let freeList = block;
        return;
    }    
}
