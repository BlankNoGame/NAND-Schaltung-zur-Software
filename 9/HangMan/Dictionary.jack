class Dictionary {

    field Array words;
    field Array masks;
    field Array lengths;
    field Array bitValues;
    field int counter;

    constructor Dictionary new() {
        var int i;

        let words = Array.new(20);
        let masks = Array.new(20);
        let lengths = Array.new(20);
        let bitValues = Array.new(14);
        let counter = 0;

        do initBitValues();
        do initWords();

        let i = 0;
        while (i < 20) {
            do buildMetaData(i);
            let i = i + 1;
        }

        return this;
    }

    method void initBitValues() {
        var int i;
        var int v;
        let i = 0;
        let v = 1;
        while (i < 14) {
            let bitValues[i] = v;
            let v = v + v;
            let i = i + 1;
        }
        return;
    }

    method Array getBitValues() {
        return bitValues;
    }

    method void initWords() {
        var Array w;

        let w = Array.new(6);
        let w[0] = 78; let w[1] = 65; let w[2] = 82;
        let w[3] = 85; let w[4] = 84; let w[5] = 79;
        let words[0] = w; let lengths[0] = 6;

        let w = Array.new(4);
        let w[0] = 71; let w[1] = 79; let w[2] = 75; let w[3] = 85;
        let words[1] = w; let lengths[1] = 4;

        let w = Array.new(7);
        let w[0] = 83; let w[1] = 85; let w[2] = 83; let w[3] = 65;
        let w[4] = 78; let w[5] = 79; let w[6] = 79;
        let words[2] = w; let lengths[2] = 7;

        let w = Array.new(5);
        let w[0] = 83; let w[1] = 72; let w[2] = 82;
        let w[3] = 69; let w[4] = 75;
        let words[3] = w; let lengths[3] = 5;

        let w = Array.new(6);
        let w[0] = 65; let w[1] = 77; let w[2] = 79;
        let w[3] = 71; let w[4] = 85; let w[5] = 83;
        let words[4] = w; let lengths[4] = 6;

        let w = Array.new(4);
        let w[0] = 68; let w[1] = 79; let w[2] = 71; let w[3] = 69;
        let words[5] = w; let lengths[5] = 4;

        let w = Array.new(6);
        let w[0] = 83; let w[1] = 69; let w[2] = 78;
        let w[3] = 80; let w[4] = 65; let w[5] = 73;
        let words[6] = w; let lengths[6] = 6;

        let w = Array.new(5);
        let w[0] = 87; let w[1] = 65; let w[2] = 73;
        let w[3] = 70; let w[4] = 85;
        let words[7] = w; let lengths[7] = 5;

        let w = Array.new(8);
        let w[0] = 71; let w[1] = 73; let w[2] = 71; let w[3] = 65;
        let w[4] = 67; let w[5] = 72; let w[6] = 65; let w[7] = 68;
        let words[8] = w; let lengths[8] = 8;

        let w = Array.new(6);
        let w[0] = 66; let w[1] = 65; let w[2] = 78;
        let w[3] = 75; let w[4] = 65; let w[5] = 73;
        let words[9] = w; let lengths[9] = 6;

        let w = Array.new(5);
        let w[0] = 84; let w[1] = 73; let w[2] = 84;
        let w[3] = 65; let w[4] = 78;
        let words[10] = w; let lengths[10] = 5;

        let w = Array.new(6);
        let w[0] = 72; let w[1] = 79; let w[2] = 75;
        let w[3] = 65; let w[4] = 71; let w[5] = 69;
        let words[11] = w; let lengths[11] = 6;

        let w = Array.new(7);
        let w[0] = 83; let w[1] = 72; let w[2] = 73;
        let w[3] = 78; let w[4] = 79; let w[5] = 66; let w[6] = 73;
        let words[12] = w; let lengths[12] = 7;

        let w = Array.new(8);
        let w[0] = 85; let w[1] = 76; let w[2] = 84; let w[3] = 82;
        let w[4] = 65; let w[5] = 77; let w[6] = 65; let w[7] = 78;
        let words[13] = w; let lengths[13] = 8;

        let w = Array.new(9);
        let w[0] = 70; let w[1] = 73; let w[2] = 78; let w[3] = 65;
        let w[4] = 76; let w[5] = 66; let w[6] = 79; let w[7] = 83;
        let w[8] = 83;
        let words[14] = w; let lengths[14] = 9;

        let w = Array.new(9);
        let w[0] = 79; let w[1] = 86; let w[2] = 69; let w[3] = 82;
        let w[4] = 80; let w[5] = 79; let w[6] = 87; let w[7] = 69;
        let w[8] = 82;
        let words[15] = w; let lengths[15] = 9;

        let w = Array.new(6);
        let w[0] = 68; let w[1] = 82; let w[2] = 65;
        let w[3] = 71; let w[4] = 79; let w[5] = 78;
        let words[16] = w; let lengths[16] = 6;

        let w = Array.new(7);
        let w[0] = 76; let w[1] = 69; let w[2] = 86; let w[3] = 69;
        let w[4] = 76; let w[5] = 85; let w[6] = 80;
        let words[17] = w; let lengths[17] = 7;

        let w = Array.new(5);
        let w[0] = 65; let w[1] = 78; let w[2] = 73;
        let w[3] = 77; let w[4] = 69;
        let words[18] = w; let lengths[18] = 5;

        let w = Array.new(8);
        let w[0] = 71; let w[1] = 65; let w[2] = 77; let w[3] = 69;
        let w[4] = 79; let w[5] = 86; let w[6] = 69; let w[7] = 82;
        let words[19] = w; let lengths[19] = 8;

        return;
    }

    method void buildMetaData(int idx) {
        var Array word;
        var Array mask;
        var int i;
        var int asciiIndex;

        let word = words[idx];
        let mask = Array.new(26);

        let i = 0;
        while (i < 26) {
            let mask[i] = 0;
            let i = i + 1;
        }

        let i = 0;
        while (i < lengths[idx]) {
            let asciiIndex = word[i] - 65;
            let mask[asciiIndex] = mask[asciiIndex] + bitValues[i];
            let i = i + 1;
        }

        let masks[idx] = mask;
        return;
    }

    method int getNextIndex() {
        var int index;
        let counter = counter + 1;
        let index   = counter / 3;
        let index   = index - ((index / 20) * 20);
        return index;
    }

    method Array getWord(int i) {
        return words[i];
    }

    method Array getMask(int i) {
        return masks[i];
    }

    method int getLength(int i) {
        return lengths[i];
    }
}